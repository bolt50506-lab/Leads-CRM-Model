# Production configuration
# For a company deployment, PostgreSQL is recommended.
DATABASE_URL=postgresql+psycopg://leadflow:change-this-password@localhost:5432/leadflow
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=replace-before-first-production-start
# Used only when DATABASE_URL is not set (single-server fallback)
LEADFLOW_DATA_DIR=./data
